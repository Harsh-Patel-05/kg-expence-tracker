# Copy to .env and fill values. Never commit .env to git.

# Avoid 5000 on macOS — AirPlay Receiver often uses it and returns 403 to curl/browser.
PORT=5050

# MongoDB Atlas connection string (or local mongodb://...)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/restaurant_tracker?retryWrites=true&w=majority

# JWT not used (single-user local mode). Optional if you re-enable /api/auth later.
# JWT_SECRET=
# JWT_EXPIRES_IN=7d

# Allowed browser origin for CORS (your static site URL). Use * only for local dev.
# Example: https://kilogram-expance-trakker.web.app
# Must match the URL you open in the browser (see npm run serve / npm run local).
CLIENT_URL=http://localhost:8765

# --- Optional: Firebase / Firestore (see FIREBASE_SETUP.md) ---
# Paste the full JSON of your Firebase service account (single line), OR use a file path:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
