PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5000

# KDS REST (required for /api/kds)
KDS_API_KEY=change-me-to-a-long-secret

# Firebase Admin (required for KDS REST writes)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# or: FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Optional: called when an order becomes ready
# KDS_READY_WEBHOOK_URL=https://example.com/hooks/order-ready
