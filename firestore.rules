rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOwner() {
      return signedIn() && (userRole() == 'owner' || userRole() == 'admin');
    }

    function isManager() {
      return signedIn() && (userRole() == 'manager' || userRole() == 'admin' || userRole() == 'owner');
    }

    function isStaff() {
      return signedIn() && userRole() in [
        'owner', 'admin', 'manager', 'cashier', 'captain', 'kitchen', 'chef', 'delivery'
      ];
    }

    function canUseApp() {
      return signedIn();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isOwner() || isManager());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || isOwner());
      allow delete: if isOwner();
    }

    /**
     * Website online orders.
     * Customers (anonymous auth) may create "placed" orders and read their own order by ID.
     * Staff manage status; customers cannot change prices, totals, or status after create.
     */
    match /onlineOrders/{orderId} {
      function isValidCreate() {
        let d = request.resource.data;
        return d.orderStatus == 'placed'
          && d.customerUid == request.auth.uid
          && d.orderId == orderId
          && d.keys().hasAll([
            'orderId', 'customerUid', 'customer', 'items', 'pricing',
            'orderType', 'paymentMethod', 'paymentStatus', 'orderStatus', 'statusHistory'
          ])
          && d.orderType in ['delivery', 'pickup']
          && d.pricing.keys().hasAll(['subtotal', 'discount', 'deliveryCharge', 'total'])
          && d.pricing.total is number
          && d.pricing.total >= 0
          && d.pricing.total <= 100000
          && d.items is list
          && d.items.size() > 0
          && d.items.size() <= 50;
      }

      allow create: if signedIn() && isValidCreate();
      // Public get by unguessable order ID so tracking links work without a sticky session.
      allow get: if true;
      allow list: if isStaff();
      allow update: if isStaff();
      allow delete: if isOwner();
    }

    /**
     * Public takeaway menu (website reads; admin POS writes).
     * Soft-deleted / unavailable filtering is done client-side.
     * Writes require a registered users/{uid} doc so anonymous website
     * customers cannot edit the catalog.
     */
    match /menuItems/{itemId} {
      allow read: if true;
      allow create, update, delete: if signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    /**
     * Website online-ordering switch (POS writes; public read so the site can gate checkout).
     */
    match /settings/onlineOrdering {
      allow get: if true;
      allow list: if false;
      allow create, update: if isStaff();
      allow delete: if isOwner();
    }

    match /{collection}/{docId} {
      allow read, write: if canUseApp()
        && collection in [
          'sales', 'purchases', 'expenses', 'inventory', 'inventory_movements',
          'stock_lots', 'recurring_expenses',
          'attendance', 'salaries', 'advances', 'suppliers', 'supplierPayments',
          'staff', 'fixedSalaries', 'reminders', 'balance_transfers', 'daily_closings',
          'investments', 'profit_withdrawals',
          'kds_orders', 'kds_menu', 'kds_settings',
          'orders',
          'customers', 'tables', 'payments', 'discounts', 'coupons', 'taxes',
          'refunds', 'kitchenTickets', 'settings', 'transactions', 'activityLogs',
          'notifications', 'orderItems', 'statusHistory', 'kitchenAssignments',
          'drivers', 'kitchenOrders', 'deliveryOrders', 'scheduledOrders',
          'bulkOrders', 'cateringOrders', 'phoneOrders',
          'recipes', 'recipeVersions', 'recipeIngredients', 'recipeCategories',
          'productionBatches', 'batchTracking', 'expiryTracking', 'physicalStock',
          'wastage', 'unitConversions', 'inventoryLogs', 'stockTransfers',
          'stockAdjustments', 'stockTransactions', 'purchaseEntries', 'vendors',
          'leaveRequests', 'incentives', 'tips', 'shifts', 'shiftAssignments',
          'performance', 'tasks', 'recurringReminders', 'notificationQueue',
          'notificationHistory', 'employeeDocuments', 'payrollHistory',
          'roles', 'permissions',
          'taskComments', 'taskChecklist', 'taskAttachments', 'taskActivity', 'taskLabels',
          'expenseCategories', 'expenseAttachments', 'expensePayments',
          'expenseAnalytics', 'expenseApprovals', 'supplierBills',
          'supplierContacts', 'supplierRatings', 'supplierTransactions',
          'supplierActivity', 'reportsCache', 'reportExports', 'analyticsSnapshots',
          'dashboardMetrics', 'notificationCenter', 'notificationPreferences',
          'userNotifications',
          'calendarEvents', 'calendarCategories',
          'documentFolders', 'documents', 'documentVersions', 'documentPermissions',
          'documentTags', 'documentComments', 'documentExpiry',
          'forecastSnapshots', 'forecastHistory', 'forecastAccuracy',
          'dailySalesSummary', 'billCounters', 'posBills', 'printJobs',
          'businessSettings', 'fixedCosts'
        ];
    }
  }
}
